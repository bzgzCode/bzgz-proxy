{
  "name": "bzgz-proxy",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=18" },
  "description": "Telegram bot + mini app that deploys personal Telegram proxies to each user's own Cloudflare account",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --no-warnings test/e2e.mjs src/core.html",
    "db:init": "wrangler d1 execute bzgz-proxy --remote --file=schema.sql"
  },
  "devDependencies": { "wrangler": "^4" }
}
